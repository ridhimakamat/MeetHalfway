# Nothing here is required to run MeetHalfway — Nominatim, OSRM, and
# Overpass's public demo servers all work with no key. These let you
# override defaults, e.g. to self-host or point at a different instance.

# Nominatim's usage policy requires a real, identifying User-Agent —
# replace with your own contact info before any real usage.
NOMINATIM_USER_AGENT=meethalfway_app (your-email@example.com)

# Public OSRM demo servers, one per travel profile.
OSRM_BASE_URL_CAR=https://router.project-osrm.org
OSRM_BASE_URL_FOOT=https://routing.openstreetmap.de/routed-foot

# Public Overpass instance.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Where saved/shareable plans are stored. Defaults to a file next to this
# app. Point at a mounted volume if your hosting wipes local disk on
# redeploy, so saved plan links keep working.
MEETHALFWAY_DB_PATH=./meethalfway.db
